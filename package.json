{
  "name": "apple-personal-growth-english-lessons-pages-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsx scripts/build-static.ts",
    "build:site": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint src worker/src worker/test scripts vite.config.ts",
    "test": "vitest run --config vitest.config.ts && vitest run --config worker/vitest.config.ts",
    "test:site": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "verify:migrations": "wrangler d1 migrations apply applications-local --local --config worker/wrangler.jsonc --persist-to .tmp/d1-migration-check",
    "verify:artifact": "tsx scripts/verify-artifact.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:migrations && pnpm build && pnpm verify:artifact && pnpm test:e2e",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.production.jsonc",
    "worker:types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "jose": "6.2.10",
    "lenis": "1.3.26",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.0.13",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "packageManager": "pnpm@10.17.1"
}
